@model ServiceHub_IT.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_LoginLayout";
}

<style>
    .login-form {
        animation: login-form-entrance 600ms ease-out both;
    }

    .login-form .form-control {
        transition: border-color 250ms ease, box-shadow 250ms ease;
    }

    .login-form .login-submit-button {
        transition: transform 225ms ease, box-shadow 225ms ease;
    }

    .login-form .login-submit-button:hover:not(:disabled) {
        transform: translateY(-2px);
    }

    .login-form .login-submit-button.is-pressed {
        transform: scale(0.97);
        transition-duration: 100ms;
    }

    .login-submit-spinner {
        width: 0.9rem;
        height: 0.9rem;
        margin-right: 0.4rem;
        vertical-align: -0.1rem;
    }

    @@keyframes login-form-entrance {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="card fade-in auth-card login-form-card">
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <form asp-action="Login" method="post" class="login-form">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3 form-field">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="name@company.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3 form-field">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" placeholder="Enter password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
        </div>

        <button type="submit" class="btn btn-primary w-100 login-submit-button">
            <span class="login-submit-label">Continue</span>
        </button>
    </form>

    <div class="mt-4 text-center login-extra-links">
        <a asp-action="ForgotPassword" class="text-decoration-none d-block">Forgot password?</a>
        <div class="mt-2">
            <span>Don't have an account?</span>
            <a asp-action="SignUp" class="text-decoration-none">Create one</a>
        </div>
    </div>
</div>

<script>
    (() => {
        const form = document.querySelector('.login-form');
        const submitButton = document.querySelector('.login-submit-button');
        const submitLabel = document.querySelector('.login-submit-label');
        submitButton?.addEventListener('click', () => {
            submitButton.classList.add('is-pressed');
            window.setTimeout(() => submitButton.classList.remove('is-pressed'), 100);
        });

        form?.addEventListener('submit', () => {
            if (!submitButton || submitButton.disabled) {
                return;
            }

            submitButton.disabled = true;
            submitLabel.textContent = 'Signing in...';
            const spinner = document.createElement('span');
            spinner.className = 'spinner-border spinner-border-sm login-submit-spinner';
            spinner.setAttribute('role', 'status');
            spinner.setAttribute('aria-label', 'Signing in');
            submitLabel.before(spinner);
        });
    })();
</script>
